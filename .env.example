# --- Server ---
PORT=3006
HOST=0.0.0.0
LOG_LEVEL=info
# Set true when a reverse proxy sets X-Forwarded-For (needed for correct click statistics and rate limits).
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
BODY_LIMIT=16384

# --- Public address: the origin short links are served from. Appears in shortUrl, QR codes and the preview page.
PUBLIC_BASE_URL=https://s.example.com

# --- Storage ---
DB_PATH=./data/shortlink.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=
# Click log rows older than this are deleted; per-link counters stay.
CLICK_RETENTION_DAYS=365
# Click rows older than this are rolled up into one row per link and day (totals and the day series stay; referrers and devices of older days go).
CLICK_RAW_DAYS=30
# Click rows are buffered and written together at least this often (ms). The per-link counter is exact and written at once.
CLICK_FLUSH_MS=1000

# --- Callers: id:secret[:role], comma separated. Roles: write (create/edit), read (list/stats/QR), readwrite (default).
# Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
SHORTLINK_API_KEYS=shop-backend:REPLACE_WITH_64_HEX_CHARS,atc-console:REPLACE_WITH_64_HEX_CHARS
# API requests per key per minute.
RATE_LIMIT_MAX=600
# Redirect / preview / QR requests per client address per minute.
REDIRECT_RATE_LIMIT_MAX=300
# How long browsers/CDNs may cache a 301 (permanent links), seconds. Disabling or expiring a link only takes effect after this. 0 = no caching.
PERMANENT_CACHE_SEC=300

# --- Links ---
# Length of generated codes (base62). 7 characters = 3.5e12 combinations.
CODE_LENGTH=7
# 301 (permanent, cached by browsers) instead of 302 for new links unless the request says otherwise.
DEFAULT_PERMANENT=false
# Destination hosts that may never be shortened (exact or subdomain match), comma separated.
BLOCKED_HOSTS=
MAX_URL_LENGTH=2048

# --- Privacy: addresses are never stored; visitors are HMAC(HASH_SECRET, ip + user agent). Generate: openssl rand -hex 32
HASH_SECRET=REPLACE_WITH_64_HEX_CHARS

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-shortlink:…:write
AUDIT_URL=
AUDIT_API_KEY=
